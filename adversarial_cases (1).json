[
  {
    "id": "TEST-021",
    "label": "Future‑dated charge: transaction timestamp ahead of current date",
    "input": {
      "ticket_id": "TKT-021",
      "complaint": "I see a charge of 2500 taka for tomorrow, 2026-05-01, but I didn't do it. Please investigate.",
      "language": "en",
      "channel": "in_app_chat",
      "user_type": "customer",
      "transaction_history": [
        {
          "transaction_id": "TXN-21001",
          "timestamp": "2026-05-01T10:00:00Z",
          "type": "payment",
          "amount": 2500,
          "counterparty": "MERCHANT-XYZ",
          "status": "completed"
        }
      ]
    },
    "expected_output": {
      "ticket_id": "TKT-021",
      "relevant_transaction_id": "TXN-21001",
      "evidence_verdict": "inconsistent",
      "case_type": "fraudulent_activity",
      "severity": "critical",
      "department": "risk_management",
      "human_review_required": true
    }
  },
